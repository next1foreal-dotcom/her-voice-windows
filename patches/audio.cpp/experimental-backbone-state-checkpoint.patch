+    // Experimental internal state checkpoint. No generator or public API uses it.
+    // Keep all KV capacity (including masked slots) plus GDN conv/recurrent data.
+    class SavedState {
+        friend class Drama3BackboneCachedDecodeGraph;
+        std::shared_ptr<const int> owner;
+        int64_t steps = 0;
+        std::vector<std::vector<unsigned char>> tensors;
+    };
+
+    SavedState capture_state() const {
+        SavedState saved;
+        saved.owner = state_identity_;
+        saved.steps = valid_steps_;
+        ggml_backend_synchronize(execution_.backend());
+        for (auto * tensor : state_tensors()) {
+            saved.tensors.emplace_back(ggml_nbytes(tensor));
+            auto & bytes = saved.tensors.back();
+            ggml_backend_tensor_get(tensor, bytes.data(), 0, bytes.size());
+        }
+        return saved;
+    }
+
+    void restore_state(const SavedState & saved) {
+        const auto tensors = state_tensors();
+        if (saved.owner != state_identity_ || saved.steps < 0 || saved.steps > cache_steps_ ||
+            saved.tensors.size() != tensors.size()) {
+            throw std::runtime_error("Drama 3 state checkpoint belongs to another decoder");
+        }
+        // Validate everything before writing: a foreign/incomplete checkpoint
+        // must leave the current continuation usable.
+        for (size_t index = 0; index < tensors.size(); ++index) {
+            if (saved.tensors[index].size() != ggml_nbytes(tensors[index])) {
+                throw std::runtime_error("Drama 3 state checkpoint tensor size mismatch");
+            }
+        }
+        ggml_backend_synchronize(execution_.backend());
+        for (size_t index = 0; index < tensors.size(); ++index) {
+            const auto & bytes = saved.tensors[index];
+            ggml_backend_tensor_set(tensors[index], bytes.data(), 0, bytes.size());
+        }
+        valid_steps_ = saved.steps;
+    }
+
     int64_t valid_steps() const noexcept {
         return valid_steps_;
     }
