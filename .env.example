# Keep this file local. Copy to .env and enter your key; never put it in web/.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash

# Optional reusable-runtime settings. Keep the DeepSeek defaults above, or use
# examples/her.env.example / joyboi.env.example with an explicit Agent endpoint.
VOICE_PROVIDER=deepseek
VOICE_APP_ID=her-voice
VOICE_APP_NAME=HER Voice
VOICE_PORT=8790
VOICE_ENGINE_PORT=8791
VOICE_DRAMA_PORT=8792

# Initial TTS default. The UI saves explicit selections in the workspace.
# Both backends require an imported reference WAV and its transcript.
VOICE_TTS_BACKEND=drama3
